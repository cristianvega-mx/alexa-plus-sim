# Copy this file to .env and fill in your own values. Never commit .env.
# Amazon Bedrock API key (Bedrock console > API keys > long-term key).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Model that plays Alexa+. It must support tool use on Bedrock.
SIM_MODEL_ID=us.amazon.nova-pro-v1:0
# The MCP server to test (Streamable HTTP).
MCP_SERVER_URL=http://127.0.0.1:3000/mcp
# Language Alexa+ listens and speaks in.
SIM_LANGUAGE=es-MX
PORT=4000
# Optional subtitles in a second language, e.g. English for a Spanish demo. Leave empty to turn off.
SIM_CAPTION_LANGUAGE=
# Optional: the date Alexa+ assumes (YYYY-MM-DD), for demos whose sample data lives on fixed dates.
# SIM_TODAY=2026-09-28
# Only for a shared deployment (see README): listen address, visitor password, model requests per hour.
# SIM_BIND=0.0.0.0
# SIM_BASIC_AUTH=user:password
# SIM_MAX_TURNS_PER_HOUR=300
